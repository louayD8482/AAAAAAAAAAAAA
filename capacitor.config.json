{
  "appId": "com.noor.alislam",
  "appName": "نور الإسلام",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "ios": {
    "minDeploymentTarget": "15.0",
    "contentInset": "always",
    "scrollEnabled": true,
    "preferredContentMode": "mobile",
    "handleApplicationURL": true
  },
  "plugins": {
    "LocalNotifications": {
      "sound": "adhan.wav"
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK"
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK"
    }
  }
}
